+
+/// The kind of the texture being created on this thread (see `aqw_texture_kind`).
+#[cfg(any(dx12, vulkan))]
+pub(crate) fn aqw_kind() -> u8 {
+    AQW_TEXTURE_KIND.with(|k| k.get())
+}
+
+/// Allocation names of the kinds, for the allocator report.
+#[cfg(any(dx12, vulkan))]
+pub(crate) fn aqw_kind_name(kind: u8) -> &'static str {
+    match kind {
+        1 => "Transient texture",
+        2 => "Cached texture",
+        _ => "Unlabeled texture",
+    }
+}
+
+/// Block sizes for kinds 1 and 2: the same as for everything else. (Fixed 16 MB blocks were
+/// tried: textures over 16 MB, such as full-window layers, then each got a driver allocation of
+/// their own, which made creating them about twice as slow in fights.)
+#[cfg(any(dx12, vulkan))]
+pub(crate) fn aqw_kind_sizes(base: AllocationSizes) -> AllocationSizes {
