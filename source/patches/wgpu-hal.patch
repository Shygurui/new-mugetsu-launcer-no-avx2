+    static AQW_TEXTURE_KIND: core::cell::Cell<u8> = const { core::cell::Cell::new(0) };
+}
+
+/// AQW build: textures created inside `f` (on this thread) get GPU memory blocks of their own
+/// for their `kind`: 1 = textures that come and go all the time (Ruffle's pooled layers),
+/// 2 = textures that live as long as some object (cacheAsBitmap pictures), 0 = everything else.
+/// Mixed into the same blocks, the holes short-lived textures left were pinned by long-lived
+/// ones, so few blocks were ever given back (a 4 GB card had 3 GB reserved for 1 GB used after
+/// minutes). Kept apart, freeing the spare pooled textures empties whole blocks.
+#[cfg(any(dx12, vulkan))]
+pub fn aqw_texture_kind<R>(kind: u8, f: impl FnOnce() -> R) -> R {
+    let was = AQW_TEXTURE_KIND.with(|k| k.replace(kind.min(2)));
+    let result = f();
+    AQW_TEXTURE_KIND.with(|k| k.set(was));
+    result
