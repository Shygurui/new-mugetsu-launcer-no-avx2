+    /// AQW build: creates a few command lists on a background thread at startup, so the first
+    /// frames don't create them (render passes are recorded and merged, see `record`, so only a
+    /// few dozen real lists are in use); `RUFFLE_DX12_PREWARM_LISTS` overrides the count
+    /// (0 = off).
+    fn prewarm_command_lists(device: Direct3D12::ID3D12Device, shared: Arc<super::DeviceShared>) {
+        let count = std::env::var("RUFFLE_DX12_PREWARM_LISTS")
+            .ok()
+            .and_then(|count| count.parse::<usize>().ok())
+            .unwrap_or(64);
+        if count == 0 {
+            return;
+        }
+        let _ = std::thread::Builder::new()
+            .name("dx12 command lists".into())
+            .spawn(move || {
+                let start = Instant::now();
+                let allocator: Direct3D12::ID3D12CommandAllocator = match unsafe {
+                    device.CreateCommandAllocator(Direct3D12::D3D12_COMMAND_LIST_TYPE_DIRECT)
+                } {
+                    Ok(allocator) => allocator,
+                    Err(_) => return,
+                };
+                let mut made = 0;
+                'outer: while made < count {
+                    let mut batch = Vec::with_capacity(256);
+                    for _ in 0..256.min(count - made) {
+                        let list: Direct3D12::ID3D12GraphicsCommandList = match unsafe {
+                            device.CreateCommandList(
+                                0,
+                                Direct3D12::D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                &allocator,
+                                None,
+                            )
+                        } {
+                            Ok(list) => list,
+                            Err(_) => break 'outer,
+                        };
+                        if unsafe { list.Close() }.is_ok() {
+                            batch.push(list);
+                        }
+                        made += 1;
+                    }
+                    shared.free_command_lists.lock().extend(batch);
+                    // The device was dropped meanwhile: stop.
+                    if Arc::strong_count(&shared) == 1 {
+                        break;
+                    }
+                }
+                *shared.prewarm_allocator.lock() = Some(allocator);
+                log::warn!(
+                    "AQW: pre-created {made} DirectX 12 command lists in {:.1} s",
+                    start.elapsed().as_secs_f64()
+                );
+            });
+    }
