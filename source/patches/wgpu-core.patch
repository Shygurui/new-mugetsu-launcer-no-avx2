+/// AQW build: waits until finished command buffers handed to the background drop thread are
+/// dropped, so the resources only they kept alive are really freed (e.g. before retrying an
+/// allocation that ran out of memory).
+pub fn aqw_flush_encoder_drops() {
+    device::flush_encoder_drops();
+}
+
+/// AQW build: textures created inside `f` get GPU memory blocks of their own for their
+/// `kind` (see `wgpu_hal::aqw_texture_kind`).
+pub fn aqw_texture_kind<R>(kind: u8, f: impl FnOnce() -> R) -> R {
+    #[cfg(any(dx12, vulkan))]
+    {
+        hal::aqw_texture_kind(kind, f)
+    }
+    #[cfg(not(any(dx12, vulkan)))]
+    {
+        let _ = kind;
+        f()
+    }
+}
+
+/// AQW build: (encoders waiting to be dropped, submissions in flight), for Ruffle's perf log.
+pub fn aqw_stats() -> (usize, usize) {
+    use core::sync::atomic::Ordering::Relaxed;
+    use aqw_stats::*;
+    (
+        ENCODERS_QUEUED.load(Relaxed).saturating_sub(ENCODERS_DROPPED.load(Relaxed)),
+        ACTIVE_SUBMISSIONS.load(Relaxed),
+    )
+}
+
+/// AQW build: counters for Ruffle's perf log.
+pub mod aqw_stats {
+    use core::sync::atomic::AtomicUsize;
+    /// Finished command encoders handed to the background drop thread / dropped by it.
+    pub static ENCODERS_QUEUED: AtomicUsize = AtomicUsize::new(0);
+    pub static ENCODERS_DROPPED: AtomicUsize = AtomicUsize::new(0);
+    /// Submissions the GPU hasn't finished (as of the last triage).
+    pub static ACTIVE_SUBMISSIONS: AtomicUsize = AtomicUsize::new(0);
+}
