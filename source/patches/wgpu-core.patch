+/// AQW build of Ruffle: drops finished command buffers on a background thread instead of
+/// inside `Queue::submit` on the caller's (main) thread. Everything they hold is only kept
+/// alive for GPU work that has already completed, and resource destruction is thread-safe.
+/// `WGPU_INLINE_ENCODER_DROP` restores dropping inline.
+#[cfg(feature = "std")]
+fn drop_finished_encoders(encoders: Vec<EncoderInFlight>) {
+    use std::sync::{mpsc, Mutex, OnceLock};
+    if encoders.is_empty() {
+        return;
+    }
+    static SENDER: OnceLock<Option<Mutex<mpsc::Sender<Vec<EncoderInFlight>>>>> = OnceLock::new();
+    let sender = SENDER.get_or_init(|| {
+        if std::env::var_os("WGPU_INLINE_ENCODER_DROP").is_some() {
+            return None;
+        }
+        let (sender, receiver) = mpsc::channel::<Vec<EncoderInFlight>>();
+        std::thread::Builder::new()
+            .name("wgpu encoder drop".into())
+            .spawn(move || {
+                for batch in receiver {
+                    profiling::scope!("drop command buffer trackers");
+                    let count = batch.len();
+                    drop(batch);
+                    crate::aqw_stats::ENCODERS_DROPPED
+                        .fetch_add(count, core::sync::atomic::Ordering::Release);
+                }
+            })
+            .ok()?;
+        Some(Mutex::new(sender))
+    });
+    let count = encoders.len();
+    let encoders = match sender {
+        Some(sender) => match sender.lock().map(|s| {
+            crate::aqw_stats::ENCODERS_QUEUED.fetch_add(count, core::sync::atomic::Ordering::Relaxed);
+            s.send(encoders)
+        }) {
+            Ok(Ok(())) => return,
+            Ok(Err(mpsc::SendError(encoders))) => encoders,
+            Err(_) => return,
+        },
+        None => encoders,
+    };
+    profiling::scope!("drop command buffer trackers");
+    drop(encoders);
+}
+
+/// AQW build: waits until the background thread has dropped every command buffer handed to
+/// it so far (at most 2 s). Needed before reconfiguring a surface.
+#[cfg(feature = "std")]
+pub(crate) fn flush_encoder_drops() {
+    use core::sync::atomic::Ordering;
+    let queued = crate::aqw_stats::ENCODERS_QUEUED.load(Ordering::Acquire);
+    let start = std::time::Instant::now();
+    while crate::aqw_stats::ENCODERS_DROPPED.load(Ordering::Acquire) < queued
+        && start.elapsed() < std::time::Duration::from_secs(2)
+    {
+        std::thread::sleep(std::time::Duration::from_micros(200));
+    }
+}
+
+#[cfg(not(feature = "std"))]
+pub(crate) fn flush_encoder_drops() {}
+
+#[cfg(not(feature = "std"))]
+fn drop_finished_encoders(encoders: Vec<EncoderInFlight>) {
+    profiling::scope!("drop command buffer trackers");
+    drop(encoders);
+}
